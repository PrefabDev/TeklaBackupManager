<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <Version>0.1.0-alpha.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-alpha.2</InformationalVersion>
    <AssemblyName>TeklaBackupManager</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);.audit-local/**;artifacts/**;tests/**</DefaultItemExcludes>
    <RootNamespace>TeklaBackupManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;.audit-local/**;artifacts/**" />
    <EmbeddedResource Remove="tests/**;.audit-local/**;artifacts/**" />
    <None Remove=".audit-local/**;artifacts/**" />
  </ItemGroup>

</Project>
